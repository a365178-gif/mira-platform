{
  "name": "mira-platform",
  "version": "1.0.0",
  "private": true,
  "description": "MIRA｜覓然 design system and cross-platform starter",
  "scripts": {
    "dev:web": "pnpm --filter @mira/web dev",
    "dev:mobile": "pnpm --filter @mira/mobile start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
